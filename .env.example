# Server-only values. Never use NEXT_PUBLIC_ for these.
# Exact production origin, no trailing slash; localhost only during development.
APP_URL=http://localhost:3000
DATABASE_URL=
# At least 16 characters; independent secrets of at least 32 characters.
OWNER_PASSWORD=
SESSION_SECRET=
# Exactly 32 random bytes encoded as base64; retain securely across deploys.
TOKEN_ENCRYPTION_KEY=
# Set the exact one or two owner Gmail addresses, comma-separated; no wildcards.
OWNER_EMAILS=baohuynhneko@gmail.com,baohkg2410154@usth.edu.vn
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# OAuth redirect: APP_URL/api/google/callback
# Use an actual API key, never a ChatGPT/Hermes subscription OAuth token.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=
# Vercel automatically supplies Authorization: Bearer CRON_SECRET to cron calls.
CRON_SECRET=
# Optional reminder channels. Bot must already be able to message this chat.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional verified Resend sender, and exactly ONE allowlisted owner recipient.
RESEND_API_KEY=
RESEND_FROM=
REMINDER_EMAIL_TO=
